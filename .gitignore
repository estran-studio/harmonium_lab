# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/

# Downloaded reference MIDI files (re-download with: make corpus)
references/*/*.mid
references/*/*.midi

# Generated reference profiles (rebuild with: make profiles)
# Anciens profils : gitignorés. Profils trad (D3) : VERSIONNÉS.
references/ambient/profile.json
references/classical-simple/profile.json
references/jazz-calm/profile.json
references/jazz-upbeat/profile.json
references/training-backing/profile.json
!references/trad-*/profile.json

# Analysis output
target/

# Corpus trad québécois : seuls manifest.jsonl et VERSION sont versionnés
# (ABC/JSON téléchargés : jamais commités ; recréés par `make trad-corpus`)
corpus/trad/*
!corpus/trad/manifest.jsonl
!corpus/trad/VERSION

# SoundFonts privés du comparatif SK3 (seul le manifeste est versionné)
samples/fiddles/raw/
