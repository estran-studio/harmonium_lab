# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/

# Downloaded reference MIDI files (re-download with: make corpus)
references/*/*.mid
references/*/*.midi

# Generated reference profiles (rebuild with: make profiles)
references/*/profile.json

# Analysis output
target/

# Corpus trad québécois : seuls manifest.jsonl et VERSION sont versionnés
# (ABC/JSON téléchargés : jamais commités ; recréés par `make trad-corpus`)
corpus/trad/*
!corpus/trad/manifest.jsonl
!corpus/trad/VERSION

# Pieds SK1 : seuls manifeste, sélection et revue sont versionnés
# (échantillons téléchargés, préparés et enregistrements du propriétaire : jamais commités)
samples/feet/raw/
samples/feet/prepared/
samples/feet/own/
